# Copy this file to mobile/.env and add values from Supabase > Connect.
# This publishable (anon) key is public. Never put a service_role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Backend URL reachable from your PHONE (not localhost).
# Example: http://192.168.1.5:8000
EXPO_PUBLIC_API_URL=http://YOUR-LAPTOP-LAN-IP:8000
